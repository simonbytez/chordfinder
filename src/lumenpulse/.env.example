# ─────────────────────────────────────────────────────────────────────────────
# LumenPulse (/flashlights) configuration. Copy what you need into the repo-root
# .env.local, and set the same names in Vercel for boomcat.me.
# Everything is optional for local dev: with no LUMENPULSE_DATABASE_URL the app
# runs on an embedded PGlite (real Postgres compiled to WASM) under
# .data/lumenpulse and seeds itself on first boot.
# Names without the LUMENPULSE_ prefix are shared across boomcat.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL (Neon, Supabase, RDS, local). Omit locally to use embedded PGlite.
# Required on Vercel. If this is unset, DATABASE_URL or POSTGRES_URL is used, which is what
# connecting a Neon database in the Vercel dashboard creates.
# Supabase: use the pooled connection string (port 6543); prepared statements are disabled for you.
LUMENPULSE_DATABASE_URL=

# Origin used in notification links, RSS and emails. On Vercel it defaults to the
# production domain, so this is only needed to override it.
# LUMENPULSE_SITE_URL=https://boomcat.me

# Shared secret for /api/flashlights/cron/* (send as `Authorization: Bearer <secret>`).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Protects /flashlights/admin (and the admin server actions) with HTTP Basic auth. Any username works.
LUMENPULSE_ADMIN_PASSWORD=

# ── LLM spec extraction (optional; the deterministic regex parser is the fallback) ──
GEMINI_API_KEY=
# LUMENPULSE_GEMINI_MODEL=gemini-2.5-flash
# Alternatively OpenAI Structured Outputs:
# OPENAI_API_KEY=
# LUMENPULSE_OPENAI_MODEL=gpt-5-mini
# Max LLM extractions per source per run (new products only):
# LUMENPULSE_LLM_MAX_EXTRACTIONS_PER_RUN=20

# ── Email (Resend) ──
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend. onboarding@resend.dev only delivers to your own account email.
LUMENPULSE_EMAIL_FROM=LumenPulse <onboarding@resend.dev>

# ── Web Push (VAPID). `npm run lumenpulse:vapid` writes these into .env.local ──
LUMENPULSE_VAPID_PUBLIC_KEY=
LUMENPULSE_VAPID_PRIVATE_KEY=
LUMENPULSE_VAPID_SUBJECT=mailto:you@example.com

# ── Optional tuning ──
# LUMENPULSE_NTFY_TOKEN=                      # access token if you publish to a protected ntfy server
# LUMENPULSE_CRAWLER_USER_AGENT=              # override the crawler's User-Agent (keep it honest and identifiable)
# LUMENPULSE_SHOPIFY_MAX_PAGES=4              # products.json pages (250 each) per run; newest-first, so 4 is plenty
# LUMENPULSE_SITEMAP_MAX_PAGES_PER_RUN=15     # new product pages fetched per sitemap run (politeness)
# LUMENPULSE_SITEMAP_RECHECK_PER_RUN=6        # known sitemap listings re-checked for price/stock per run
# LUMENPULSE_AUTO_MIGRATE=true                # run SQL migrations on first DB use
# LUMENPULSE_AUTO_SEED=true                   # seed starter sources + 26 lights into an empty catalog
# LUMENPULSE_PGLITE_DIR=.data/lumenpulse
# LUMENPULSE_DB_POOL_MAX=5
